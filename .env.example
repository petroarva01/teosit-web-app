# Contact form email (https://resend.com). Without these, `next dev` only logs messages.
RESEND_API_KEY=
# Sender on a domain verified in Resend, e.g. "TEOS IT <website@teosit.com>"
CONTACT_FROM_EMAIL=
# Optional, defaults to office@teosit.com
CONTACT_TO_EMAIL=

# Google Analytics 4 measurement ID (G-XXXXXXXXXX). Loaded only after cookie consent.
NEXT_PUBLIC_GA_ID=
# LinkedIn Insight Tag partner ID. Loaded only after marketing cookie consent.
NEXT_PUBLIC_LINKEDIN_PARTNER_ID=
# Optional: LinkedIn conversion ID fired on a successful contact form (Campaign Manager → Conversions).
NEXT_PUBLIC_LINKEDIN_LEAD_CONVERSION_ID=
